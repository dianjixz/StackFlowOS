{
  "name": "stackflowos-webui",
  "private": true,
  "version": "0.1.0",
  "description": "StackFlowOS operator console, built with the Astryx design system.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:assets": "vite build --outDir ../stackflowos/webassets --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "0.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
